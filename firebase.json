{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git",
      ".git/**",
      ".zcode",
      ".zcode/**",
      "**/node_modules/**",
      "**/*.md",
      "**/*.txt",
      "**/*.log",
      "**/package.json",
      "**/package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "render.yaml",
      "render-deploy*.md"
    ]
  }
}
