rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAccount() {
      return request.auth != null &&
        request.auth.token.email in [
          'admin@alsaqri.store',
          'user@alsaqri.store'
        ];
    }

    match /{document=**} {
      allow read, write: if isAuthorizedAccount();
    }
  }
}
