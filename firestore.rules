rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // القراءة والكتابة تتطلب جلسة مسجلة — التطبيق يسجل دخولاً مجهولاً تلقائياً
    // (انظر js/firebase-config-cdn.js). هذا يغلق الباب أمام الماسحات الآلية
    // والوصول المباشر عبر REST بالمفتاح العام وحده.
    // ملاحظة: ليس بديلاً عن صلاحيات لكل مستخدم — عند إضافة حسابات حقيقية
    // فصّل القواعد لكل مجموعة (phones, sales, maintenanceJobs...).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
